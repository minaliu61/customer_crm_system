<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaee.system.mapper.ProductMapper">
    <resultMap id="ProductMap" type="com.javaee.system.po.Product">
        <id property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="productNumber" column="product_code"/>
        <result property="category" column="category_id"/>
        <result property="description" column="description"/>
        <result property="price" column="price"/>
        <result property="costPrice" column="discount_price"/>
        <result property="stock" column="stock"/>
        <result property="sales" column="sales"/>
        <result property="status" column="status"/>
        <result property="imagePath" column="image"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <sql id="selectProductVo">
        SELECT 
            product_id, product_name, product_code, category_id, description, 
            price, discount_price, stock, sales, status, image, 
            create_time, update_time
        FROM product
    </sql>
    <select id="selectById" parameterType="Long" resultMap="ProductMap">
        <include refid="selectProductVo"/>
        WHERE product_id = #{productId}
    </select>
    <select id="selectByProductNumber" parameterType="String" resultMap="ProductMap">
        <include refid="selectProductVo"/>
        WHERE product_code = #{productNumber}
    </select>
    <select id="selectAll" resultMap="ProductMap">
        <include refid="selectProductVo"/>
        ORDER BY product_id ASC
    </select>
    <select id="selectByCondition" parameterType="com.javaee.system.po.Product" resultMap="ProductMap">
        <include refid="selectProductVo"/>
        <where>
            <if test="productId != null">
                AND product_id = #{productId}
            </if>
            <if test="productNumber != null and productNumber != ''">
                AND product_name LIKE CONCAT('%', #{productNumber}, '%')
            </if>
            <if test="productNumber != null and productNumber != ''">
                AND product_code LIKE CONCAT('%', #{productNumber}, '%')
            </if>
            <if test="category != null and category != ''">
                AND category_id = #{category}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>
    <select id="selectByCategory" parameterType="String" resultMap="ProductMap">
        <include refid="selectProductVo"/>
        WHERE category_id = #{category}
    </select>
    <select id="selectByIds" resultMap="ProductMap">
        <include refid="selectProductVo"/>
        WHERE product_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
    <insert id="insert" parameterType="com.javaee.system.po.Product" useGeneratedKeys="true" keyProperty="productId">
        INSERT INTO product (
            product_name, product_code, category_id, description, price, 
            discount_price, stock, sales, status, image, 
            create_time, update_time
        ) VALUES (
            #{productName}, #{productNumber}, #{category}, #{description}, #{price},
            #{costPrice}, #{stock}, #{sales}, #{status}, #{imagePath}, 
            NOW(), NOW()
        )
    </insert>
    <update id="update" parameterType="com.javaee.system.po.Product">
        UPDATE product
        <set>
            <if test="productNumber != null and productNumber != ''">
                product_name = #{productNumber},
            </if>
            <if test="productNumber != null and productNumber != ''">
                product_code = #{productNumber},
            </if>
            <if test="category != null and category != ''">
                category_id = #{category},
            </if>
            <if test="description != null">
                description = #{description},
            </if>
            <if test="price != null">
                price = #{price},
            </if>
            <if test="costPrice != null">
                discount_price = #{costPrice},
            </if>
            <if test="stock != null">
                stock = #{stock},
            </if>
            <if test="sales != null">
                sales = #{sales},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="imagePath != null and imagePath != ''">
                image = #{imagePath},
            </if>
            update_time = NOW()
        </set>
        WHERE product_id = #{productId}
    </update>
    <delete id="deleteById" parameterType="Long">
        DELETE FROM product WHERE product_id = #{productId}
    </delete>
    <delete id="deleteBatch">
        DELETE FROM product WHERE product_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper> 