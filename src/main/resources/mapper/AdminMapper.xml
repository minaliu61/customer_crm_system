<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaee.system.mapper.AdminMapper">
    <resultMap id="AdminResultMap" type="com.javaee.system.po.Admin">
        <id property="adminId" column="admin_id" />
        <result property="userId" column="user_id" />
        <result property="position" column="position" />
        <result property="department" column="department" />
        <association property="user" javaType="com.javaee.system.po.User">
            <id property="userId" column="user_id" />
            <result property="username" column="username" />
            <result property="password" column="password" />
            <result property="realName" column="real_name" />
            <result property="phone" column="phone" />
            <result property="email" column="email" />
            <result property="avatar" column="avatar" />
            <result property="role" column="role" />
            <result property="status" column="status" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
        </association>
    </resultMap>
    <sql id="Admin_Column_List">
        a.admin_id, a.user_id, a.position, a.department
    </sql>
    <sql id="User_Column_List">
        u.user_id, u.username, u.password, u.real_name, u.phone, u.email,
        u.avatar, u.role, u.status, u.create_time, u.update_time
    </sql>
    <select id="selectByUserId" resultMap="AdminResultMap">
        SELECT
            <include refid="Admin_Column_List" />,
            <include refid="User_Column_List" />
        FROM
            admin a
        INNER JOIN
            user u ON a.user_id = u.user_id
        WHERE
            a.user_id = #{userId}
    </select>
    <select id="selectAll" resultMap="AdminResultMap">
        SELECT
            <include refid="Admin_Column_List" />,
            <include refid="User_Column_List" />
        FROM
            admin a
        INNER JOIN
            user u ON a.user_id = u.user_id
        ORDER BY
            u.create_time DESC
    </select>
    <select id="selectByCondition" resultMap="AdminResultMap">
        SELECT
            <include refid="Admin_Column_List" />,
            <include refid="User_Column_List" />
        FROM
            admin a
        INNER JOIN
            user u ON a.user_id = u.user_id
        <where>
            u.role = 1
            <if test="searchText != null and searchText != ''">
                AND (
                    u.username LIKE CONCAT('%', #{searchText}, '%')
                    OR u.real_name LIKE CONCAT('%', #{searchText}, '%')
                    OR u.phone LIKE CONCAT('%', #{searchText}, '%')
                    OR u.email LIKE CONCAT('%', #{searchText}, '%')
                    OR a.position LIKE CONCAT('%', #{searchText}, '%')
                    OR a.department LIKE CONCAT('%', #{searchText}, '%')
                )
            </if>
        </where>
        ORDER BY
            u.create_time DESC
    </select>
    <insert id="insert" parameterType="com.javaee.system.po.Admin">
        INSERT INTO admin (
            user_id, position, department
        ) VALUES (
            #{userId}, #{position}, #{department}
        )
    </insert>
    <update id="update" parameterType="com.javaee.system.po.Admin">
        UPDATE admin
        <set>
            <if test="position != null">
                position = #{position},
            </if>
            <if test="department != null">
                department = #{department},
            </if>
        </set>
        WHERE user_id = #{userId}
    </update>
    <delete id="deleteByUserId" parameterType="long">
        DELETE FROM admin WHERE user_id = #{userId}
    </delete>
</mapper>