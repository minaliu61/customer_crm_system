<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaee.system.mapper.OrderItemMapper">

    <resultMap id="OrderItemMap" type="com.javaee.system.po.OrderItem">
        <id property="itemId" column="item_id"/>
        <result property="orderId" column="order_id"/>
        <result property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="productNumber" column="product_number"/>
        <result property="productPrice" column="product_price"/>
        <result property="quantity" column="quantity"/>
        <result property="subtotalAmount" column="subtotal_amount"/>
        <result property="discountAmount" column="discount_amount"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <!-- 关联查询产品信息 -->
        <association property="product" javaType="com.javaee.system.po.Product">
            <id property="productId" column="prod_id"/>
            <result property="name" column="prod_name"/>
            <result property="productNumber" column="prod_number"/>
            <result property="price" column="prod_price"/>
            <result property="category" column="category"/>
            <result property="imagePath" column="image_path"/>
        </association>
    </resultMap>

    <sql id="selectOrderItemVo">
        SELECT 
            oi.item_id, oi.order_id, oi.product_id,
        oi.price,
            oi.subtotal,  oi.create_time, oi.update_time,
            p.product_id as prod_id, p.product_name as prod_name, p.product_code as prod_number,
            p.price as prod_price, p.category_id
        FROM 
            order_item oi
        LEFT JOIN 
            product p ON oi.product_id = p.product_id
    </sql>

    <select id="selectById" parameterType="Long" resultMap="OrderItemMap">
        <include refid="selectOrderItemVo"/>
        WHERE oi.item_id = #{itemId}
    </select>

    <select id="selectByOrderId" parameterType="Long" resultMap="OrderItemMap">
        <include refid="selectOrderItemVo"/>
        WHERE oi.order_id = #{orderId}
    </select>

    <select id="selectByProductId" parameterType="Long" resultMap="OrderItemMap">
        <include refid="selectOrderItemVo"/>
        WHERE oi.product_id = #{productId}
    </select>

    <insert id="insert" parameterType="com.javaee.system.po.OrderItem" useGeneratedKeys="true" keyProperty="itemId">
        INSERT INTO order_item (
            order_id, product_id, product_name, product_number, 
            product_price, quantity, subtotal_amount, discount_amount, 
            create_time, update_time
        ) VALUES (
            #{orderId}, #{productId}, #{productName}, #{productNumber}, 
            #{productPrice}, #{quantity}, #{subtotalAmount}, #{discountAmount}, 
            #{createTime}, #{updateTime}
        )
    </insert>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO order_item (
            order_id, product_id, product_name, product_number, 
            product_price, quantity, subtotal_amount, discount_amount, 
            create_time, update_time
        ) VALUES 
        <foreach collection="orderItems" item="item" separator=",">
            (
                #{item.orderId}, #{item.productId}, #{item.productName}, #{item.productNumber}, 
                #{item.productPrice}, #{item.quantity}, #{item.subtotalAmount}, #{item.discountAmount}, 
                #{item.createTime}, #{item.updateTime}
            )
        </foreach>
    </insert>

    <update id="update" parameterType="com.javaee.system.po.OrderItem">
        UPDATE order_item
        <set>
            <if test="orderId != null">
                order_id = #{orderId},
            </if>
            <if test="productId != null">
                product_id = #{productId},
            </if>
            <if test="productName != null and productName != ''">
                product_name = #{productName},
            </if>
            <if test="productNumber != null and productNumber != ''">
                product_number = #{productNumber},
            </if>
            <if test="productPrice != null">
                product_price = #{productPrice},
            </if>
            <if test="quantity != null">
                quantity = #{quantity},
            </if>
            <if test="subtotalAmount != null">
                subtotal_amount = #{subtotalAmount},
            </if>
            <if test="discountAmount != null">
                discount_amount = #{discountAmount},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        WHERE item_id = #{itemId}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM order_item WHERE item_id = #{itemId}
    </delete>

    <delete id="deleteByOrderId" parameterType="Long">
        DELETE FROM order_item WHERE order_id = #{orderId}
    </delete>
</mapper> 